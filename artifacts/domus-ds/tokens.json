{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Domus Design System — DTCG tokens. Paleta ink (azuis profundos da noite), azul-500 como ação, ciano-400 como luz da marca, Inter + IBM Plex Mono. Edite apenas este arquivo; o dev-server regenera src/index.css e src/generated/tokens.tsx automaticamente.",
  "color": {
    "$type": "color",
    "light": {
      "background":              { "$value": "#F1F4F9", "$description": "Fundo da página — ink-50" },
      "foreground":              { "$value": "#080B14", "$description": "Texto padrão — ink-900" },
      "card":                    { "$value": "#FFFFFF", "$description": "Superfície de cartão — ink-0" },
      "cardForeground":          { "$value": "#080B14" },
      "popover":                 { "$value": "#FFFFFF" },
      "popoverForeground":       { "$value": "#080B14" },
      "primary": {
        "$value": "#0E40AB",
        "$description": "Azul de ação no tema claro — azul-600"
      },
      "primaryForeground":       { "$value": "#FFFFFF" },
      "secondary":               { "$value": "#E3E8F1", "$description": "Superfície secundária — ink-100" },
      "secondaryForeground":     { "$value": "#080B14" },
      "muted":                   { "$value": "#F1F4F9", "$description": "Superfície silenciada — ink-50" },
      "mutedForeground":         { "$value": "#323D5A", "$description": "Texto silenciado — ink-600" },
      "accent": {
        "$value": "#1452D6",
        "$description": "Azul de destaque no tema claro — azul-500"
      },
      "accentForeground":        { "$value": "#FFFFFF" },
      "destructive":             { "$value": "#E72314", "$description": "Vermelho de erro no tema claro" },
      "destructiveForeground":   { "$value": "#FFFFFF" },
      "border":                  { "$value": "#CBD3E3", "$description": "Borda decorativa — ink-200" },
      "input":                   { "$value": "#B6C0D6", "$description": "Borda de controle — ink-250" },
      "ring":                    { "$value": "#0E40AB", "$description": "Anel de foco — azul-600" },
      "chart1":                  { "$value": "#0E40AB", "$description": "Série 1 — azul" },
      "chart2":                  { "$value": "#0E7F92", "$description": "Série 2 — ciano" },
      "chart3":                  { "$value": "#2D8659", "$description": "Série 3 — verde sucesso" },
      "chart4":                  { "$value": "#9B6E19", "$description": "Série 4 — âmbar atenção" },
      "chart5":                  { "$value": "#7E5FE3", "$description": "Série 5 — lilás sistema" },
      "sidebar":                 { "$value": "#F1F4F9" },
      "sidebarForeground":       { "$value": "#080B14" },
      "sidebarBorder":           { "$value": "#CBD3E3" },
      "sidebarPrimary":          { "$value": "#0E40AB" },
      "sidebarPrimaryForeground":{ "$value": "#FFFFFF" },
      "sidebarAccent":           { "$value": "#E3E8F1" },
      "sidebarAccentForeground": { "$value": "#080B14" },
      "sidebarRing":             { "$value": "#0E40AB" }
    },
    "dark": {
      "background":              { "$value": "#05070D", "$description": "Fundo da página — ink-950" },
      "foreground":              { "$value": "#E3E8F1", "$description": "Texto padrão — ink-100" },
      "card":                    { "$value": "#0C101B", "$description": "Superfície de cartão — ink-850" },
      "cardForeground":          { "$value": "#E3E8F1" },
      "popover":                 { "$value": "#0C101B" },
      "popoverForeground":       { "$value": "#E3E8F1" },
      "primary": {
        "$value": "#1452D6",
        "$description": "Azul de ação — azul-500"
      },
      "primaryForeground":       { "$value": "#FBFCFE" },
      "secondary":               { "$value": "#171D2E", "$description": "Superfície secundária — ink-750" },
      "secondaryForeground":     { "$value": "#E3E8F1" },
      "muted":                   { "$value": "#0C101B", "$description": "Superfície silenciada — ink-850" },
      "mutedForeground":         { "$value": "#9EAAC6", "$description": "Texto silenciado — ink-300" },
      "accent": {
        "$value": "#2E70EF",
        "$description": "Azul de hover — azul-400"
      },
      "accentForeground":        { "$value": "#FBFCFE" },
      "destructive":             { "$value": "#FF6E63", "$description": "Vermelho de erro — erro-tinta" },
      "destructiveForeground":   { "$value": "#FBFCFE" },
      "border":                  { "$value": "#1E2639", "$description": "Borda decorativa — ink-700" },
      "input":                   { "$value": "#273049", "$description": "Borda de controle — ink-650" },
      "ring":                    { "$value": "#2E70EF", "$description": "Anel de foco — azul-400" },
      "chart1":                  { "$value": "#1452D6", "$description": "Série 1 — azul" },
      "chart2":                  { "$value": "#2BD0E4", "$description": "Série 2 — ciano" },
      "chart3":                  { "$value": "#3FCE87", "$description": "Série 3 — verde sucesso" },
      "chart4":                  { "$value": "#F0B23C", "$description": "Série 4 — âmbar atenção" },
      "chart5":                  { "$value": "#A78FF5", "$description": "Série 5 — lilás sistema" },
      "sidebar":                 { "$value": "#05070D" },
      "sidebarForeground":       { "$value": "#E3E8F1" },
      "sidebarBorder":           { "$value": "#1E2639" },
      "sidebarPrimary":          { "$value": "#1452D6" },
      "sidebarPrimaryForeground":{ "$value": "#FBFCFE" },
      "sidebarAccent":           { "$value": "#171D2E" },
      "sidebarAccentForeground": { "$value": "#E3E8F1" },
      "sidebarRing":             { "$value": "#2E70EF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "Tipografia de interface — Inter" },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "monospace"], "$description": "Números, IDs, código — IBM Plex Mono" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.625rem", "$description": "Raio base (10px). xs=4px s=6px m=10px g=16px pill=999px" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Passo base de espaçamento (4px). O sistema usa múltiplos de 4." }
  }
}
