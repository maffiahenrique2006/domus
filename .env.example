# Domus System — MVP acadêmico (Vértice Espaços)
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite um `.env` com valores reais — este arquivo deve conter apenas
# nomes de variáveis, sem segredos.

# Chave de API da OpenAI. Usada apenas no servidor (artifacts/api-server),
# nunca é exposta ao navegador. Sem ela, a Domus AI responde com um erro
# claro (503) em vez de simular uma resposta.
OPENAI_API_KEY=

# Modelo da OpenAI usado pela Domus AI (ex.: gpt-4.1-mini). O servidor nunca
# troca este valor silenciosamente — se ele faltar, a Domus AI fica indisponível.
OPENAI_MODEL=

# String de conexão do PostgreSQL (Neon, Replit DB ou instância local).
DATABASE_URL=

# Assina os cookies de sessão (login) e o cookie de state do OAuth.
# Obrigatória para o login com Google funcionar — use um valor aleatório longo.
SESSION_SECRET=

# Origem pública absoluta da aplicação (ex.: https://domus-mvp.vercel.app,
# ou http://localhost:5000 localmente). Usada para montar o redirect_uri do
# Google e as URLs de sucesso/cancelamento do Stripe.
APP_URL=

# Credenciais OAuth 2.0 do Google Cloud Console (tipo "Web application").
# Sem elas, o botão "Entrar com Google" responde com um erro claro (503)
# em vez de simular um login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave secreta do Stripe em modo de TESTE (começa com sk_test_). Sem ela,
# o botão de assinatura responde com um erro claro (503) em vez de simular
# um checkout.
STRIPE_SECRET_KEY=

# ID do Price recorrente ("Plano Pro") criado no Stripe em modo de teste.
STRIPE_PRICE_ID=

# Assinatura do endpoint de webhook do Stripe (começa com whsec_), usada
# para verificar que os eventos recebidos em /api/billing/webhook vieram
# do Stripe de verdade.
STRIPE_WEBHOOK_SECRET=

# Porta em que cada serviço escuta. No Replit é atribuída automaticamente;
# localmente, defina um valor (ex.: 5000).
PORT=

# Caminho base do frontend (Vite). Use "/" para servir a partir da raiz.
BASE_PATH=/

# "development" ou "production".
NODE_ENV=production
