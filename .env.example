# Domus System — MVP acadêmico (Vértice Espaços)
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite um `.env` com valores reais — este arquivo deve conter apenas
# nomes de variáveis, sem segredos.

# Chave de API da OpenAI. Usada apenas no servidor (artifacts/api-server),
# nunca é exposta ao navegador. Sem ela, a Domus AI responde com um erro
# claro (503) em vez de simular uma resposta.
OPENAI_API_KEY=

# Modelo da OpenAI usado pela Domus AI (ex.: gpt-4.1-mini). O servidor nunca
# troca este valor silenciosamente — se ele faltar, a Domus AI fica indisponível.
OPENAI_MODEL=

# String de conexão do PostgreSQL (Neon, Replit DB ou instância local).
DATABASE_URL=

# Assina/valida sessões do servidor, se a sessão estiver habilitada.
SESSION_SECRET=

# Porta em que cada serviço escuta. No Replit é atribuída automaticamente;
# localmente, defina um valor (ex.: 5000).
PORT=

# Caminho base do frontend (Vite). Use "/" para servir a partir da raiz.
BASE_PATH=/

# "development" ou "production".
NODE_ENV=production
